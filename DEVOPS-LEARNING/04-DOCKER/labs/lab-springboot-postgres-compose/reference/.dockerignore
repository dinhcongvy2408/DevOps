# Đặt ở GỐC REPO (cạnh compose.yaml) — build context là gốc repo.
# Không gửi những thứ này vào build context.
.git
.github
.idea
.vscode
**/*.iml
**/target/
**/*.log
# Secret: tuyệt đối không để lọt vào image
.env
.env.*
!.env.example
