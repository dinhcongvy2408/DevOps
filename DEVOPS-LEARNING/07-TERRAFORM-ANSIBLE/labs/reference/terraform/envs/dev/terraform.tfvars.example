# Chép thành terraform.tfvars (đã nằm trong .gitignore) rồi sửa giá trị của bạn.
# Không có bí mật nào ở đây — mật khẩu database do Terraform tự sinh (ephemeral) và không lưu ở đâu cả.

owner       = "phuong"
github_repo = "phuong-dev/taskhub"
alert_email = "you@example.com"

# Các biến dưới đây đã có giá trị mặc định — chỉ khai báo nếu network plan của bạn khác.
