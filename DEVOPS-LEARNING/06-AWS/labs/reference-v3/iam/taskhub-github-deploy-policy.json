{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheRunShellScriptDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:ap-southeast-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "OnlyInstancesTaggedProjectTaskhub",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:ap-southeast-1:111122223333:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "taskhub"
        }
      }
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FindTheInstance",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
