{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTaskhubParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-1:111122223333:parameter/taskhub/dev/*"
    },
    {
      "Sid": "WriteTaskhubLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:111122223333:log-group:/taskhub/dev/*:*"
    }
  ]
}
